{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "segmantR-interchange-v1/model-card.schema.json",
  "title": "segmantR model card (model_card.json in .segmantR bundles)",
  "description": "Versioned model card. The legacy fields written by segmantR 0.1.0 (name, description, backend, base_model, training_metrics, model_card, created, packaged, segmantR_version, format) are kept for backward compatibility.",
  "type": "object",
  "required": ["schema", "schema_version", "name", "description", "backend",
               "base_model", "purpose", "data_domain", "channels",
               "target_pixel_size_um", "input_value_semantics", "limitations",
               "license", "evaluation", "weights", "training_metrics",
               "model_card", "created", "packaged", "segmantR_version", "format"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "segmantR-model-card-v1"},
    "schema_version": {"$ref": "common.schema.json#/definitions/semver_v1"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "backend": {"enum": ["cellpose", "stardist"]},
    "base_model": {"type": "string"},
    "purpose": {"type": ["string", "null"]},
    "data_domain": {"type": ["string", "null"]},
    "channels": {"type": "array", "items": {"type": "string"}},
    "target_pixel_size_um": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "input_value_semantics": {"$ref": "common.schema.json#/definitions/value_semantics"},
    "normalization": {"type": ["object", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "license": {
      "type": "object",
      "required": ["id", "file"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": ["string", "null"]},
        "file": {"oneOf": [{"$ref": "common.schema.json#/definitions/relpath"}, {"type": "null"}]},
        "source": {"type": ["string", "null"]}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["metrics", "dataset_digest", "split"],
      "additionalProperties": false,
      "properties": {
        "metrics": {"type": "object"},
        "dataset_digest": {"$ref": "common.schema.json#/definitions/nullable_digest"},
        "split": {"enum": ["train", "validation", "test", null]}
      }
    },
    "weights": {
      "type": "object",
      "required": ["embedded", "representation", "files"],
      "additionalProperties": false,
      "properties": {
        "embedded": {"type": "boolean"},
        "representation": {"enum": ["pb", "savedmodel", "bioimageio", "pytorch",
                                    "keras", "directory", "file", "unknown"]},
        "relative_to": {"enum": ["bundle", "bundle_parent"]},
        "digest": {"$ref": "common.schema.json#/definitions/nullable_digest"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "size_bytes", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {"$ref": "common.schema.json#/definitions/relpath"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "common.schema.json#/definitions/sha256_hex"}
            }
          }
        }
      }
    },
    "dataset_manifest": {"oneOf": [{"$ref": "common.schema.json#/definitions/relpath"}, {"type": "null"}]},
    "runtime": {"oneOf": [{"$ref": "common.schema.json#/definitions/relpath"}, {"type": "null"}]},
    "training_metrics": {"type": "object"},
    "model_card": {"type": "object"},
    "created": {"type": "string"},
    "packaged": {"type": "string"},
    "segmantR_version": {"type": "string"},
    "format": {"enum": ["segmantR", "cellpose", "both"]},
    "extensions": {"$ref": "common.schema.json#/definitions/extensions"}
  }
}
