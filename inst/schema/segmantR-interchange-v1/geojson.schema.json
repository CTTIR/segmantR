{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "segmantR-interchange-v1/geojson.schema.json",
  "title": "GeoJSON image-coordinate profile (QuPath compatible)",
  "description": "Coordinates are image pixels (origin top-left, y down), not WGS84. No crs member.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "features": {"type": "array", "items": {"$ref": "#/definitions/feature"}}
  },
  "not": {"required": ["crs"]},
  "definitions": {
    "position": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 3
    },
    "ring": {"type": "array", "items": {"$ref": "#/definitions/position"}, "minItems": 4},
    "geometry": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["Point", "MultiPoint", "LineString", "MultiLineString",
                          "Polygon", "MultiPolygon", "GeometryCollection"]},
        "plane": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "Polygon"}}},
          "then": {
            "required": ["coordinates"],
            "properties": {
              "coordinates": {"type": "array", "minItems": 1,
                              "items": {"$ref": "#/definitions/ring"}}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "MultiPolygon"}}},
          "then": {
            "required": ["coordinates"],
            "properties": {
              "coordinates": {
                "type": "array", "minItems": 1,
                "items": {"type": "array", "minItems": 1,
                          "items": {"$ref": "#/definitions/ring"}}
              }
            }
          }
        }
      ]
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": ["string", "integer"]},
        "geometry": {"$ref": "#/definitions/geometry"},
        "nucleusGeometry": {"$ref": "#/definitions/geometry"},
        "properties": {
          "type": ["object", "null"],
          "properties": {
            "objectType": {"enum": ["annotation", "detection", "cell", "tile", "tma_core"]},
            "label": {"type": "integer", "minimum": 1},
            "object_id": {"type": "string"},
            "geometry_fidelity": {"enum": ["exact", "approximated", "unsupported"]},
            "classification": {
              "type": ["object", "null"],
              "properties": {
                "name": {"type": "string"},
                "names": {"type": "array", "items": {"type": "string"}},
                "color": {"type": "array", "items": {"type": "integer"}}
              }
            },
            "measurements": {"type": ["object", "array", "null"]}
          }
        }
      }
    }
  }
}
