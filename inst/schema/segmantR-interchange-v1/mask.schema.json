{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "segmantR-interchange-v1/mask.schema.json",
  "title": "segmantR integer label mask description",
  "description": "0 is background; positive integers are instances (instance), class codes (labelled) or foreground (binary, value 1). revision may be null for producers that cannot compute the segmantR revision rule (e.g. QuPath templates); importers then compute it.",
  "type": "object",
  "required": [
    "id",
    "image_id",
    "mask_type",
    "dtype",
    "background",
    "shape_yx",
    "label_count",
    "max_label",
    "plane",
    "origin",
    "connectivity",
    "content_digest",
    "revision",
    "review",
    "legend"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "image_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mask_type": {
      "enum": [
        "instance",
        "labelled",
        "binary"
      ]
    },
    "dtype": {
      "enum": [
        "uint8",
        "uint16",
        "uint32",
        "int32"
      ]
    },
    "background": {
      "const": 0
    },
    "shape_yx": {
      "$ref": "common.schema.json#/definitions/shape_yx"
    },
    "label_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_label": {
      "type": "integer",
      "minimum": 0
    },
    "plane": {
      "$ref": "common.schema.json#/definitions/plane"
    },
    "origin": {
      "$ref": "common.schema.json#/definitions/origin"
    },
    "connectivity": {
      "enum": [
        4,
        8,
        null
      ]
    },
    "content_digest": {
      "$ref": "common.schema.json#/definitions/digest"
    },
    "revision": {
      "$ref": "common.schema.json#/definitions/nullable_digest"
    },
    "review": {
      "$ref": "common.schema.json#/definitions/review"
    },
    "legend": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/legend_entry"
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "model_digest": {
      "$ref": "common.schema.json#/definitions/nullable_digest"
    },
    "transform_digest": {
      "$ref": "common.schema.json#/definitions/nullable_digest"
    }
  }
}
