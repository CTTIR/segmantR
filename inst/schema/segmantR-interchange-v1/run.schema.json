{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "segmantR-interchange-v1/run.schema.json",
  "title": "segmantR segmentation run envelope",
  "description": "Records a declarative protocol run and the exact delegate call so that direct and declarative runs can be compared.",
  "type": "object",
  "required": ["schema", "schema_version", "kind", "run_id", "status",
               "protocol", "parameters", "parameters_digest", "delegate",
               "inputs", "outputs", "seed", "runtime", "started", "finished",
               "warnings", "extensions"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "segmantR-interchange-v1"},
    "schema_version": {"$ref": "common.schema.json#/definitions/semver_v1"},
    "kind": {"const": "segmentation-run"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "unavailable"]},
    "protocol": {"$ref": "common.schema.json#/definitions/protocol_ref"},
    "parameters": {"type": "object"},
    "parameters_digest": {"$ref": "common.schema.json#/definitions/digest"},
    "delegate": {
      "type": "object",
      "required": ["function", "arguments", "backend"],
      "additionalProperties": false,
      "properties": {
        "function": {"type": "string"},
        "arguments": {"type": "object"},
        "backend": {"type": "string"},
        "postprocess": {"type": "array", "items": {"type": "object"}}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "type", "id", "digest"],
        "additionalProperties": false,
        "properties": {
          "role": {"type": "string"},
          "type": {"enum": ["sg_image", "sg_mask", "sg_trained_model"]},
          "id": {"type": ["string", "null"]},
          "digest": {"$ref": "common.schema.json#/definitions/nullable_digest"},
          "channel_selection": {"type": ["object", "null"]}
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["mask"],
      "additionalProperties": false,
      "properties": {
        "mask": {
          "type": ["object", "null"],
          "required": ["content_digest", "revision", "label_count", "mask_type", "dtype", "status"],
          "additionalProperties": false,
          "properties": {
            "content_digest": {"$ref": "common.schema.json#/definitions/digest"},
            "revision": {"$ref": "common.schema.json#/definitions/digest"},
            "label_count": {"type": "integer", "minimum": 0},
            "mask_type": {"enum": ["instance", "labelled", "binary"]},
            "dtype": {"enum": ["uint8", "uint16", "uint32", "int32"]},
            "status": {"enum": ["draft", "staged", "reviewed"]},
            "shape_yx": {"$ref": "common.schema.json#/definitions/shape_yx"}
          }
        },
        "measurements": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "n_objects": {"type": "integer", "minimum": 0},
            "names": {"type": "array", "items": {"type": "string"}},
            "digest": {"$ref": "common.schema.json#/definitions/digest"}
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "required": ["policy", "value", "rng_kind"],
      "additionalProperties": false,
      "properties": {
        "policy": {"enum": ["deterministic", "fixed", "backend"]},
        "value": {"type": ["integer", "null"]},
        "rng_kind": {"type": ["string", "null"]}
      }
    },
    "runtime": {"$ref": "runtime.schema.json"},
    "started": {"$ref": "common.schema.json#/definitions/timestamp"},
    "finished": {"$ref": "common.schema.json#/definitions/timestamp"},
    "duration_s": {"type": ["number", "null"], "minimum": 0},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "class": {"type": "string"},
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "extensions": {"$ref": "common.schema.json#/definitions/extensions"}
  }
}
