{
  "description": "Thresholds one channel with the adaptive rule, applies morphological opening and hole filling, labels 4-connected components and removes objects outside the area limits. Delegates to sg_segment_threshold() with identical defaults.",
  "extensions": {

  },
  "family": "threshold",
  "id": "threshold.adaptive.v1",
  "input_contract": {
    "array_order": "y,x,channel",
    "calibration": {
      "parameters": [

      ],
      "required": "never"
    },
    "channel": {
      "min_channels": 1,
      "operation": "single",
      "parameters": [
        "channel",
        "channel_name",
        "wavelength_nm",
        "band_operation"
      ]
    },
    "inputs": [
      {
        "description": "Image providing the segmentation channel.",
        "required": true,
        "role": "image",
        "type": "sg_image"
      }
    ],
    "min_shape_yx": [
      3,
      3
    ],
    "value_range": {
      "max": null,
      "min": null,
      "policy": "observed"
    },
    "value_semantics": [
      "unknown",
      "intensity",
      "raw",
      "reflectance",
      "radiance",
      "absorbance",
      "probability"
    ]
  },
  "method": {
    "backend": "segmantR-core",
    "delegate": "sg_segment_threshold",
    "fixed_arguments": {
      "method": "adaptive"
    },
    "mapping": {
      "block_size": "block_size",
      "channel": "channel",
      "fill_holes": "morphology.fill_holes",
      "max_area": "max_area",
      "min_area": "min_area",
      "offset": "offset",
      "open_size": "morphology.open"
    }
  },
  "output_contract": {
    "background": 0,
    "connectivity": 4,
    "dtype": "int32",
    "label_order": "raster",
    "mask_type": "instance",
    "measurements": [
      "area",
      "centroid",
      "bbox",
      "mean_intensity"
    ],
    "status": "draft"
  },
  "parameters": {
    "band_a_nm": {
      "default": null,
      "description": "Wavelength of band a for ratio/normalized_difference.",
      "exclusive_minimum": 0,
      "nullable": true,
      "requires_calibration": false,
      "type": "number",
      "unit": "nm"
    },
    "band_b_nm": {
      "default": null,
      "description": "Wavelength of band b for ratio/normalized_difference.",
      "exclusive_minimum": 0,
      "nullable": true,
      "requires_calibration": false,
      "type": "number",
      "unit": "nm"
    },
    "band_max_nm": {
      "default": null,
      "description": "Upper wavelength bound for band_mean.",
      "exclusive_minimum": 0,
      "nullable": true,
      "requires_calibration": false,
      "type": "number",
      "unit": "nm"
    },
    "band_min_nm": {
      "default": null,
      "description": "Lower wavelength bound for band_mean.",
      "exclusive_minimum": 0,
      "nullable": true,
      "requires_calibration": false,
      "type": "number",
      "unit": "nm"
    },
    "band_operation": {
      "default": "none",
      "description": "Registered band operation producing the single input channel: none (use the selected channel), band_mean (mean of bands within [band_min_nm, band_max_nm]), ratio (a / b) or normalized_difference ((a - b) / (a + b)) of the bands nearest band_a_nm and band_b_nm.",
      "enum": [
        "none",
        "band_mean",
        "ratio",
        "normalized_difference"
      ],
      "requires_calibration": false,
      "type": "string",
      "unit": "none"
    },
    "block_size": {
      "default": 51,
      "description": "Odd window size of the local mean.",
      "maximum": 1025,
      "minimum": 3,
      "odd": true,
      "requires_calibration": false,
      "type": "integer",
      "unit": "px"
    },
    "channel": {
      "default": 1,
      "description": "1-based channel (band) position in the [y, x, channel] array. Used when channel_name, wavelength_nm and band_operation are not set.",
      "minimum": 1,
      "requires_calibration": false,
      "type": "integer",
      "unit": "index"
    },
    "channel_name": {
      "default": null,
      "description": "Channel or band name to select instead of an index.",
      "nullable": true,
      "requires_calibration": false,
      "type": "string",
      "unit": "name"
    },
    "fill_holes": {
      "default": true,
      "description": "Fill background holes enclosed by foreground.",
      "requires_calibration": false,
      "type": "boolean",
      "unit": "none"
    },
    "max_area": {
      "default": 5000,
      "description": "Maximum object area.",
      "minimum": 1,
      "requires_calibration": false,
      "type": "integer",
      "unit": "px2"
    },
    "min_area": {
      "default": 50,
      "description": "Minimum object area.",
      "minimum": 0,
      "requires_calibration": false,
      "type": "integer",
      "unit": "px2"
    },
    "offset": {
      "default": 0.05,
      "description": "Value subtracted from the local mean, in units of the selected channel values.",
      "requires_calibration": false,
      "type": "number",
      "unit": "intensity"
    },
    "open_size": {
      "default": 5,
      "description": "Square structuring element size for morphological opening (erosion then dilation); 0 disables opening.",
      "maximum": 51,
      "minimum": 0,
      "odd": true,
      "requires_calibration": false,
      "type": "integer",
      "unit": "px"
    },
    "wavelength_nm": {
      "default": null,
      "description": "Centre wavelength of the band to select (requires band wavelengths in the image metadata).",
      "exclusive_minimum": 0,
      "nullable": true,
      "requires_calibration": false,
      "type": "number",
      "unit": "nm"
    },
    "wavelength_tolerance_nm": {
      "default": 5,
      "description": "Maximum distance between wavelength_nm and the nearest band centre.",
      "minimum": 0,
      "requires_calibration": false,
      "type": "number",
      "unit": "nm"
    }
  },
  "postprocess": {
    "steps": [

    ]
  },
  "preprocess": {
    "normalization": {
      "clip": false,
      "high": null,
      "low": null,
      "method": "none",
      "note": "Thresholds are computed on the selected values; Otsu and triangle are invariant to affine scaling.",
      "scope": "none"
    },
    "resample": "none",
    "target_pixel_size_um": null
  },
  "provenance_policy": {
    "hash": "sha256",
    "record": [
      "protocol_digest",
      "parameters_digest",
      "input_digests",
      "runtime",
      "delegate_call",
      "mask_revision",
      "measurements_digest"
    ]
  },
  "runtime_profile": {
    "gpu": "never",
    "install_hint": null,
    "language": "R",
    "python_modules": [

    ],
    "qupath": null,
    "r_packages": [

    ],
    "requires_python": false
  },
  "schema": "segmantR-protocol-v1",
  "seed_policy": {
    "note": "The algorithm uses no random numbers.",
    "policy": "deterministic",
    "seed": null
  },
  "tiling": {
    "max_pixels": 4194304,
    "mode": "none",
    "note": "Core protocols process the whole plane in memory; split larger images before running.",
    "overlap": 0,
    "tile_size": null
  },
  "title": "Adaptive local-mean threshold",
  "version": "1.0.0"
}

